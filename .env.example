APP_NAME=AI Video Lecture Note Generator
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api

# Relative sqlite paths and STORAGE_PATH are resolved against backend/ (not the current directory).
# This file is read from the repository root (.env) regardless of where the server is started.
DATABASE_URL=sqlite:///./storage/app.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/video_notes

STORAGE_PATH=./storage
# LLM_PROVIDER options: mock, openai, gemini (ollama is not implemented yet -> mock with a warning)
# To use Gemini for lesson/chapter generation, set LLM_PROVIDER=gemini and provide GEMINI_API_KEY below.
# openai/gemini without its API key, or an unknown value, makes the server refuse to start.
# With mock, every job shows a warning that real AI was not used.
LLM_PROVIDER=mock
# STT/VISION currently support mock only. Keep these as mock unless real providers are implemented.
STT_PROVIDER=mock
VISION_PROVIDER=mock

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional: sent as reasoning_effort only when set (e.g. low, medium, high)
GEMINI_REASONING_EFFORT=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LLM HTTP client
LLM_TIMEOUT_SECONDS=120
# Retries for 429/5xx/timeouts with backoff (Retry-After is respected)
LLM_MAX_RETRIES=3
# Use the OS certificate store (helps behind corporate SSL-inspecting proxies)
LLM_USE_SYSTEM_TRUST_STORE=true
# Optional CA bundle file path; takes precedence over the system trust store
LLM_CA_BUNDLE=

# Automotive-paint caption corrections (e.g. 알료->안료): auto | automotive | none
# auto applies them only when the transcript looks like automotive painting content.
TRANSCRIPT_CORRECTION_PROFILE=auto

MAX_UPLOAD_SIZE_MB=2048
KEY_MOMENT_THRESHOLD=7
FRAME_CAPTURE_OFFSET=3
FRAME_CAPTURE_COUNT=5
FRAME_HASH_DISTANCE_THRESHOLD=8

PDF_PROVIDER=playwright
