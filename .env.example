APP_NAME=AI Video Lecture Note Generator
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api

DATABASE_URL=sqlite:///./storage/app.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/video_notes

STORAGE_PATH=./storage
LLM_PROVIDER=mock
STT_PROVIDER=mock
VISION_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

MAX_UPLOAD_SIZE_MB=2048
KEY_MOMENT_THRESHOLD=7
FRAME_CAPTURE_OFFSET=3
FRAME_CAPTURE_COUNT=5
FRAME_HASH_DISTANCE_THRESHOLD=8

PDF_PROVIDER=playwright
